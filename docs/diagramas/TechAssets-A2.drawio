<mxCell id="co" value="COESÃO&#xa;&#xa;Alta coesão: cada módulo concentra responsabilidades relacionadas ao seu objetivo.&#xa;&#xa;Exemplo: Equipamento concentra dados e operações do ativo." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="500" height="180" as="geometry"/></mxCell>
<mxCell id="ac" value="ACOPLAMENTO&#xa;&#xa;Baixo acoplamento: os módulos se comunicam por responsabilidades bem definidas.&#xa;&#xa;Controller não acessa diretamente o banco." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="500" height="180" as="geometry"/></mxCell>
<mxCell id="me" value="MELHORIA PROPOSTA&#xa;&#xa;Separar Interface, Controller, Service, Repository e Database para facilitar manutenção, testes e evolução do sistema." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="560" y="510" width="500" height="150" as="geometry"/></mxCell>

<mxCell id="d1" value="DA-01 — Separação em camadas&#xa;&#xa;Separar Interface, Controller, Service, Repository e Database para separar responsabilidades, reduzir acoplamento e facilitar manutenção." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="430" height="190" as="geometry"/></mxCell>

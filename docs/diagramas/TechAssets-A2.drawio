<mxCell id="t" value="TECHASSETS — Responsabilidades, Coesão e Acoplamento" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="700" height="40" as="geometry"/></mxCell>
<mxCell id="b1" value="INTERFACE&#xa;&#xa;• Exibir equipamentos
• Exibir detalhes
• Receber dados
• Exibir mensagens
• Pesquisa e filtros" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="b2" value="CONTROLLER&#xa;&#xa;• Receber requisições
• Validar entrada básica
• Encaminhar solicitações
• Retornar respostas
• Não conter regras de negócio" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="b3" value="SERVICE&#xa;&#xa;• Regras de negócio
• Cadastro
• Alteração de responsável/localização
• Alteração de estado
• Registro de alterações" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="b4" value="REPOSITORY&#xa;&#xa;• Persistência
• Buscar equipamentos
• Salvar/atualizar equipamentos
• Consultar histórico" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="b5" value="DATABASE&#xa;&#xa;• Usuários
• Equipamentos
• Categorias
• Histórico" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="f1" value="↓" style="text;html=1;fontSize=24;align=center;" vertex="1" parent="1"><mxGeometry x="265" y="180" width="30" height="30" as="geometry"/></mxCell>
